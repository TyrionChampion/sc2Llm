# 复制成 .env 然后填你自己的 key
#   cp .env.example .env && nano .env
#
# 只要填一家就能跑。选了哪家，就把 ARENA_PROVIDER 设成它的名字。
# .env 已在 .gitignore 里，不会被提交。

# ===== 首先：用哪家指挥官 =====
ARENA_PROVIDER=deepseek

# ===== 然后：填对应的 key（只填你要用的那家） =====

# DeepSeek  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI
# OPENAI_API_KEY=
# ARENA_PROVIDER=openai

# Anthropic
# ANTHROPIC_API_KEY=
# ARENA_PROVIDER=anthropic

# Moonshot（月之暗面）
# MOONSHOT_API_KEY=
# ARENA_PROVIDER=moonshot

# 阿里云 DashScope（通义千问）
# DASHSCOPE_API_KEY=
# ARENA_PROVIDER=dashscope

# 智谱 GLM
# ZHIPU_API_KEY=
# ARENA_PROVIDER=zhipu

# Groq
# GROQ_API_KEY=
# ARENA_PROVIDER=groq

# 本地 Ollama（不用 key，但要先 ollama serve 并 pull 模型）
# ARENA_PROVIDER=ollama
# ARENA_MODEL_OLLAMA=qwen2.5:7b

# ===== 可选：覆盖默认模型 =====
# ARENA_MODEL_DEEPSEEK=deepseek-reasoner
# ARENA_MODEL_OPENAI=gpt-4o

# ===== 可选：本机游戏运行环境 =====
# 原生窗口模式需要 Windows 版 SC2、GE-Proton、Steam 和可访问的 GPU。
# 指向包含 Versions/Support64/Interfaces 的游戏安装目录：
# ARENA_SC2_SOURCE="/path/to/StarCraft II"
# ARENA_STEAM_PATH="$HOME/.local/share/Steam"
# ARENA_PROTON_PATH="$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-7-x86_64"
